<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+): nothing of this app leaves the device - not to the cloud backup and not in a
  device-to-device transfer. The database holds the encrypted device token and the scan journal; the
  token is bound to the Android Keystore of THIS device and would be useless (or harmful) elsewhere.
  allowBackup is false as well; these rules also cover vendor transfer tools that ignore it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
    </device-transfer>
</data-extraction-rules>
