{
  "name": "tix-platform",
  "version": "1.0.0-alpha.46",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "description": "High-concurrency ticketing platform with seating editor, virtual waiting room, Vorkasse reconciliation and offline check-in.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.7.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tix/web --filter=@tix/worker --filter=@tix/realtime",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tix/db db:generate",
    "db:migrate": "pnpm --filter @tix/db db:migrate",
    "db:seed": "pnpm --filter @tix/db db:seed",
    "db:studio": "pnpm --filter @tix/db db:studio",
    "admin:create": "pnpm --filter @tix/db admin:create",
    "infra:up": "docker compose -p tix-dev up -d postgres redis minio minio-init",
    "infra:down": "docker compose -p tix-dev --profile dev-storage down",
    "db:demo": "pnpm --filter @tix/core db:demo",
    "demo:orders": "pnpm --filter @tix/worker demo:orders",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:supervisor": "node --test \"docker/supervisor/test/*.test.mjs\"",
    "test:load": "node --test \"scripts/load/test/*.test.mjs\"",
    "test:release": "node --test scripts/release/*.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
