# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure configuration only. Everything business-related (prices, fees, bank, SMTP,
# PayPal, wallet, branding …) is configured in the Admin Portal and stored in the database.
#
# cp .env.example .env, then replace every "change-me" / "REPLACE_WITH" value. Generate secrets:
#   openssl rand -hex 24                                  → passwords (URL-safe)
#   echo "k1:$(openssl rand -base64 32)"                  → APP_ENCRYPTION_KEYS
#   openssl rand -base64 48                               → SESSION_SECRET
# ─────────────────────────────────────────────────────────────────────────────

# ─── Which version to run ────────────────────────────────────────────────────
# Image tag of tix-web / tix-worker / tix-realtime (moving tags are updated by every release):
#   next      newest release of any kind, incl. alpha/beta/rc   → demo and test servers
#   stable    newest stable release                              → production
#   1 or 1.0  newest stable release of that major / minor line   → production, no major upgrades
#   alpha | beta | rc   newest pre-release of that stage
#   1.0.0 or 1.0.0-alpha.2   exact version                       → pin / roll back
TIX_CHANNEL=__TIX_CHANNEL__
# GitHub owner (lower case) of the images: ghcr.io/<owner>/tix-web
# The packages should be public (no login needed); only while they are private run
# `docker login ghcr.io` with a token that has the read:packages scope.
TIX_IMAGE_OWNER=__TIX_IMAGE_OWNER__

COMPOSE_PROJECT_NAME=tix
LOG_LEVEL=info

# ─── Public entry (Caddy reverse proxy) ──────────────────────────────────────
# URL browsers use, e.g. https://tickets.example.org (and SITE_ADDRESS=tickets.example.org)
PUBLIC_URL=http://localhost:8080
# ":80" = plain HTTP; a domain name enables automatic HTTPS (Let's Encrypt, needs ports 80/443).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Another reverse proxy / load balancer in front of Caddy (it terminates TLS)? Then list its
# address(es), space-separated IPs / CIDRs or `private_ranges`; Caddy takes the visitor address from
# the X-Forwarded-For header of that proxy. Leave empty when Caddy is the public edge (default).
# Example: SITE_ADDRESS=:80  HTTP_PORT=8080  TRUSTED_PROXIES=private_ranges
TRUSTED_PROXIES=

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=tix
POSTGRES_PASSWORD=change-me-hex-password
POSTGRES_DB=tix
# POSTGRES_MAX_CONNECTIONS=200
# WEB_DATABASE_POOL_MAX=40
# WORKER_DATABASE_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-hex-password
REDIS_MAXMEMORY=1gb
REDIS_KEY_PREFIX=tix

# ─── Object storage (S3-compatible; the bundled MinIO by default) ────────────
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-hex-password
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tix-app
S3_SECRET_ACCESS_KEY=change-me-hex-password
S3_BUCKET_ASSETS=tix-assets
S3_BUCKET_DOCUMENTS=tix-documents
# Encrypted full backups (Admin -> Backups). Needs the same APP_ENCRYPTION_KEYS to restore elsewhere.
S3_BUCKET_BACKUPS=tix-backups

# ─── Application secrets ─────────────────────────────────────────────────────
# Key ring for secrets stored in the DB (bank PINs, API secrets, signing keys).
# Comma-separated "id:base64key"; the FIRST key encrypts, all keys decrypt (rotation).
# Keep a copy outside the server: without it backups cannot be restored.
APP_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# HMAC key for signed cookies (min. 32 characters).
SESSION_SECRET=REPLACE_WITH_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# ─── Tuning ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=8
