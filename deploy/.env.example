# ─────────────────────────────────────────────────────────────────────────────
# TIX Platform - the .env file next to docker-compose.yml (save env.example as ".env").
# Only the technical basics live here. Everything business-related (prices, fees, bank, SMTP,
# PayPal, wallet, branding …) is configured in the Admin Portal and stored in the database.
#
# Rules for all values:
#   - One KEY=value per line, NO quotes and no spaces around "=".
#   - Passwords are embedded in connection URLs, so they must be URL-safe: use only letters and
#     digits (hex is perfect). Characters such as @ : / # ? % break the connection.
#
# Fill in the values below, then run:  docker compose up -d
# The file object storage (MinIO) needs no entry: its credentials are generated automatically on
# the first start and kept in a Docker volume.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required ────────────────────────────────────────────────────────────────
# The address visitors type, without a trailing slash, e.g. https://tickets.example.org
PUBLIC_URL=http://localhost:8080
# Default setup (the bundled Caddy is the public entry and fetches the HTTPS certificate):
# SITE_ADDRESS = your domain only (tickets.example.org), HTTP_PORT=80, HTTPS_PORT=443.
# Behind another reverse proxy keep ":80" and see the install guide (TRUSTED_PROXIES below).
# ":80" = plain HTTP (tests).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Passwords - use a different one for each:   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-hex-password
REDIS_PASSWORD=change-me-hex-password

# Key ring for secrets stored in the database (bank PINs, API secrets, signing keys) and for the
# encryption of backups. Format "id:base64key": an id, a colon, 32 random bytes in base64.
#   echo "k1:$(openssl rand -base64 32)"
# BACK THIS UP outside the server (password manager): without it stored secrets and backups
# cannot be decrypted or restored. Never change or remove a key that is still in use.
APP_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES

# HMAC key for signed cookies (random text of at least 32 characters):   openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# Without openssl:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   docker run --rm alpine sh -c "head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'; echo"

# ─── Which version to run ────────────────────────────────────────────────────
# Image tag of tix-web / tix-worker / tix-realtime (moving tags are updated by every release):
#   next      newest release of any kind, incl. alpha/beta/rc   → demo and test servers
#   stable    newest stable release                              → production
#   1 or 1.0  newest stable release of that major / minor line   → production, no major upgrades
#   alpha | beta | rc   newest pre-release of that stage
#   1.0.0 or 1.0.0-alpha.2   exact version                       → pin / roll back
# (Pre-filled with a channel that exists for this release; "stable" exists from 1.0.0 on.)
TIX_CHANNEL=__TIX_CHANNEL__

# ─── Optional (remove the leading "#" to use) ────────────────────────────────
# Another reverse proxy / load balancer in front of Caddy (it terminates TLS)? List its address(es),
# space-separated IPs / CIDRs or `private_ranges`; Caddy takes the visitor address from the
# X-Forwarded-For header of that proxy. Leave empty when Caddy is the public edge (default).
# Example: SITE_ADDRESS=:80  HTTP_PORT=8080  TRUSTED_PROXIES=private_ranges
# TRUSTED_PROXIES=

# Name prefix of containers and volumes - do not change after the first start.
# COMPOSE_PROJECT_NAME=tix
# LOG_LEVEL=info

# Database / Redis names and tuning (the defaults are fine for clubs).
# POSTGRES_USER=tix
# POSTGRES_DB=tix
# POSTGRES_MAX_CONNECTIONS=200
# WEB_DATABASE_POOL_MAX=40
# WORKER_DATABASE_POOL_MAX=10
# REDIS_MAXMEMORY=1gb
# REDIS_KEY_PREFIX=tix
# WORKER_CONCURRENCY=8

# Storage: region and bucket names (three different buckets).
# S3_REGION=us-east-1
# S3_BUCKET_ASSETS=tix-assets
# S3_BUCKET_DOCUMENTS=tix-documents
# Encrypted full backups (Admin -> Backups). Needs the same APP_ENCRYPTION_KEYS to restore elsewhere.
# S3_BUCKET_BACKUPS=tix-backups

# MinIO credentials - ONLY for installations created before they were generated automatically.
# New installations: leave these commented out (they are created on the first start and kept in
# the Docker volume "storage-credentials"). Existing installations: keep the values you already
# have; they are copied into that volume once and the MinIO data keeps working. Do not change
# the root values of an existing installation.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
