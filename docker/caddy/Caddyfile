# Public entry point.
#   SITE_ADDRESS=":80"                 → plain HTTP (local / behind another TLS proxy)
#   SITE_ADDRESS="tickets.example.org" → automatic HTTPS via Let's Encrypt
#
# Client address: by default Caddy is the edge. It ignores X-Forwarded-* from clients and sets
# X-Forwarded-For itself; the app uses the right-most entry (the one Caddy appended) for rate
# limiting and audit logs.
# Behind ANOTHER reverse proxy / load balancer set TRUSTED_PROXIES (.env) to its address(es):
# a space-separated list of IPs / CIDRs, or `private_ranges`. Caddy then takes the
# visitor address from the X-Forwarded-For header of that proxy (right to left, so an entry the
# visitor made up is ignored) and hands exactly that single address on to the app.
# Empty (or unset) trusts no proxy.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Correlation id: the app puts it into its JSON log lines (field reqId).
	request_header X-Request-Id {http.request.uuid}

	@realtime path /socket.io/*
	handle @realtime {
		reverse_proxy realtime:3001 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	header {
		-Server
	}
}
