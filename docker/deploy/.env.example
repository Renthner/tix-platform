# ─────────────────────────────────────────────────────────────────────────────
# TIX Platform - the .env file next to docker-compose.yml (save env.example as ".env").
# Only the technical basics live here. Everything business-related (prices, fees, bank, SMTP,
# PayPal, wallet, branding ...) is configured in the Admin Portal and stored in the database.
#
# One KEY=value per line, NO quotes and no spaces around "=". The password must be URL-safe
# (letters and digits only; hex is perfect).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required ────────────────────────────────────────────────────────────────
# The address visitors type, without a trailing slash, e.g. https://tickets.example.org
APP_URL=http://localhost:8080

# Database password:   openssl rand -hex 24
POSTGRES_PASSWORD=change-me-hex-password

# Key ring that encrypts the secrets stored in the database (bank PINs, API secrets, signing keys)
# and your backups. Create one with
#   docker run --rm ghcr.io/__TIX_IMAGE_OWNER__/tix:__TIX_VERSION__ keygen
# and paste the printed line (format "id:base64key"; the id is random, e.g. k3fa9c1, so that
# separate systems rarely share one - existing "k1" keys keep working). BACK IT UP outside the server (password
# manager): without it stored secrets and backups cannot be decrypted, also not on another server.
# Never change or remove a key that is still in use.
APP_ENCRYPTION_KEYS=REPLACE_WITH_KEYGEN_OUTPUT_ID:BASE64_32_BYTES

# Which version to run (image tag):
#   stable    newest stable release                              -> production
#   next      newest release of any kind, incl. alpha/beta/rc   -> test servers
#   1 | 1.0   newest stable release of that major / minor line
#   1.0.0 or 1.0.0-alpha.2   exact version: a plain "docker compose up" stays on it; tix-update.sh
#             moves it to the newest release of its line (pre-release: newest release of the
#             same major version, final: newest final release of the same major version)
# (Pre-filled with a channel that exists for this release; "stable" exists from 1.0.0 on.)
TIX_VERSION=__TIX_CHANNEL__

# ─── Optional (remove the leading "#" to use) ────────────────────────────────
# IMPORTANT behind a reverse proxy: list the address(es) of YOUR proxy, space-separated IPs / CIDRs
# or `private_ranges` (all private networks, covers Docker networks and a proxy on the same
# host). TIX then reads the visitor address from the X-Forwarded-For header of that proxy.
# Left empty nobody is trusted: every visitor appears with the address of the proxy, so rate
# limits and the audit log act on the proxy instead of the visitor. Only list proxies you run.
# With an https APP_URL a proxy is always in front: use its EXACT IP/CIDR (not a broad range) and
# publish the port only on its interface (HTTP_PORT=127.0.0.1:8081). TIX warns at startup about an
# empty list with https, about private_ranges and about 0.0.0.0/0.
# TRUSTED_PROXIES=private_ranges

# Host check of the built-in proxy: when APP_URL is not a loopback address, a request from an
# untrusted address with a foreign Host header gets 421 (so http://<server-ip>:8080 fails). List
# extra accepted names (comma separated) or * for any. Requests from TRUSTED_PROXIES are not checked.
# TIX_ALLOWED_HOSTS=
# Limits of the built-in proxy (0 = off): client inactivity ms, time to receive one request ms,
# concurrent connections per client address.
# TIX_PROXY_SOCKET_TIMEOUT_MS=120000
# TIX_PROXY_REQUEST_TIMEOUT_MS=3600000
# TIX_PROXY_MAX_CONNS_PER_IP=200
# Overload protection: requests the built-in proxy runs at the same time PER web process (pages, API, assets);
# more wait in a queue and get 503 BUSY (Retry-After 5) after the queue timeout (ms; default 30000 pages,
# 10000 API/assets; 0 = wait forever). Keep the three limits together below 500.
# TIX_WEB_PAGE_CONCURRENCY=16
# TIX_WEB_API_CONCURRENCY=96
# TIX_WEB_STATIC_CONCURRENCY=128
# TIX_PROXY_QUEUE_TIMEOUT_MS=

# More than one CPU core for the shop: number of web processes (1-16 or auto = the CPUs the container may
# use, at most 8). Each one needs memory (WEB_MAX_OLD_SPACE_MB=768) and a share of the database connections.
# TIX_WEB_PROCESSES=auto
# Upper bound for all database connections of the container (PostgreSQL allows 100 by default). Above it
# the pool of each web process is reduced at startup (the log says so); too many processes refuse to start.
# TIX_DB_CONNECTION_BUDGET=90
# Anonymous visitors of the start page and event pages share one render per web process for this long (ms;
# max 60000, 0 = off). Admin changes empty the cache at once. Memory for it per web process in MB.
# TIX_PAGE_CACHE_TTL_MS=5000
# TIX_PAGE_CACHE_MAX_MB=32

# Restoring a backup made by ANOTHER installation (different APP_ENCRYPTION_KEYS) is switched off.
# Set 1 only for the time of such a migration. WARNING: a restore executes the archive's SQL as the
# database user (a superuser in the stock postgres image), so with this on a SUPER_ADMIN who can
# build an archive under a key they enter can run arbitrary SQL there (COPY ... PROGRAM = code
# execution in the database container). Enable it only if every SUPER_ADMIN is fully trusted.
# Apply a change with `docker compose up -d` (a plain `docker compose restart` does NOT re-read .env).
# After the restore the admin can re-encrypt the restored secrets with this system's key (Admin -> Backups).
# TIX_ALLOW_FOREIGN_BACKUP_KEYS=1

# Port on the server for plain HTTP (point your reverse proxy here).
# HTTP_PORT=8080

# Name prefix of containers and volumes - do not change after the first start.
# COMPOSE_PROJECT_NAME=tix
# LOG_LEVEL=info

# Before an update changes the database, an encrypted database backup is taken (Admin -> Backups,
# "Before update"). If it fails nothing is migrated; 1 skips it (not recommended).
# SKIP_PRE_UPDATE_BACKUP=1

# Files live in the volume tix-data (STORAGE_DIR=/data/storage). To use an S3-compatible service
# (MinIO, AWS S3 ...) instead, see docs/STORAGE.md and docker-compose.s3.example.yml:
# S3_ENDPOINT=https://s3.example.org
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_ASSETS=tix-assets
# S3_BUCKET_DOCUMENTS=tix-documents
# S3_BUCKET_BACKUPS=tix-backups
