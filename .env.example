# ─────────────────────────────────────────────────────────────────────────────
# Infrastructure configuration only. Everything business-related (prices, fees, TTLs,
# bank connections, SMTP, PayPal, wallet certificates, branding …) is configured in the
# Admin Portal and stored in the database.
#
# Generate secrets, e.g.:
#   openssl rand -hex 24                                  → passwords (URL-safe)
#   echo "k1:$(openssl rand -base64 32)"                  → APP_ENCRYPTION_KEYS
#   openssl rand -base64 48                               → SESSION_SECRET
# ─────────────────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=tix
LOG_LEVEL=info

# ─── Public entry (docker compose: Caddy reverse proxy) ─────────────────────
# URL browsers use. Production: https://tickets.example.org (and SITE_ADDRESS=tickets.example.org)
PUBLIC_URL=http://localhost:8080
# ":80" = plain HTTP; a domain name enables automatic HTTPS (Let's Encrypt).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Another reverse proxy in front of Caddy? List its address(es) (space-separated IPs / CIDRs or
# `private_ranges`) so the visitor address is read from its X-Forwarded-For. Empty = Caddy is the edge.
TRUSTED_PROXIES=

# ─── Local development (pnpm dev) ────────────────────────────────────────────
# Next.js dev server and the realtime gateway run on separate ports locally.
APP_URL=http://localhost:3000
REALTIME_PUBLIC_URL=http://localhost:3001
REALTIME_CORS_ORIGINS=http://localhost:3000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=tix
POSTGRES_PASSWORD=change-me-hex-password
POSTGRES_DB=tix
POSTGRES_PORT=5432
# Connection budget (compose): web pool 40 per replica + worker pool 10 + realtime + migrate/backups
# must stay below max_connections (default 200; see docs/LOAD-TEST.md "Tuning").
# POSTGRES_MAX_CONNECTIONS=200
# WEB_DATABASE_POOL_MAX=40
# WORKER_DATABASE_POOL_MAX=10
# Used by local `pnpm dev` / CLI tools (containers build their own URL from the values above).
DATABASE_URL=postgres://tix:change-me-hex-password@localhost:5432/tix
# Integration tests (never loaded from this file): export these in your shell and point them at a
# THROW-AWAY Postgres/Redis, never at your real stack. Without TIX_TEST_THROWAWAY=1 they are skipped.
# TIX_TEST_THROWAWAY=1
# TEST_DATABASE_URL=postgres://postgres:change-me@127.0.0.1:25432/postgres
# TEST_REDIS_URL=redis://127.0.0.1:26379/0

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-hex-password
REDIS_PORT=6379
REDIS_MAXMEMORY=1gb
REDIS_KEY_PREFIX=tix
REDIS_URL=redis://:change-me-hex-password@localhost:6379/0

# ─── Object storage (S3-compatible) ──────────────────────────────────────────
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-hex-password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tix-app
S3_SECRET_ACCESS_KEY=change-me-hex-password
S3_BUCKET_ASSETS=tix-assets
S3_BUCKET_DOCUMENTS=tix-documents
# Encrypted full backups (Admin -> Backups). Needs the same APP_ENCRYPTION_KEYS to restore elsewhere.
S3_BUCKET_BACKUPS=tix-backups
S3_FORCE_PATH_STYLE=true

# ─── Application secrets ─────────────────────────────────────────────────────
# Key ring for secrets stored in the DB (bank PINs, API secrets, signing keys).
# Comma-separated "id:base64key"; the FIRST key encrypts, all keys decrypt (rotation).
APP_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# HMAC key for signed cookies (min. 32 characters).
SESSION_SECRET=REPLACE_WITH_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# ─── Tuning ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=8
